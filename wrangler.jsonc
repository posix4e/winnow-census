{
  // The census site as a Worker with static assets: index.html and one JSON
  // per day under census/, assembled into site/ by the workflows. No Worker
  // script; Cloudflare serves the files. The custom domain below makes
  // Cloudflare create the DNS record and certificate itself.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winnow-census",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "census.winnowwallet.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
